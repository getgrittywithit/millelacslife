---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Get all businesses from content collection
const allBusinesses = await getCollection('businesses');

// Group by category
const businessesByCategory = allBusinesses.reduce((acc, business) => {
  const cat = business.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(business);
  return acc;
}, {} as Record<string, typeof allBusinesses>);

// Featured businesses
const featuredBusinesses = allBusinesses.filter(b => b.data.featured);

const categories = [
  {
    name: 'Resorts & Lodging',
    slug: 'resort',
    icon: '🏠',
    count: businessesByCategory['resort']?.length || 0,
    description: 'Lakeside resorts, cabins, and vacation rentals around Mille Lacs.',
  },
  {
    name: 'Restaurants & Bars',
    slug: 'restaurant',
    icon: '🍽️',
    count: businessesByCategory['restaurant']?.length || 0,
    description: 'Local dining from casual lakeside spots to fine dining.',
  },
  {
    name: 'Fishing Guides',
    slug: 'guide',
    icon: '🎣',
    count: businessesByCategory['guide']?.length || 0,
    description: 'Expert local guides for walleye, pike, and bass fishing.',
  },
  {
    name: 'Boat Rentals',
    slug: 'boat-rental',
    icon: '⛵',
    count: businessesByCategory['boat-rental']?.length || 0,
    description: 'Pontoons, fishing boats, and watercraft rentals.',
  },
  {
    name: 'Bait & Tackle',
    slug: 'bait-shop',
    icon: '🪱',
    count: businessesByCategory['bait-shop']?.length || 0,
    description: 'Bait shops, tackle stores, and fishing supplies.',
  },
  {
    name: 'Marinas',
    slug: 'marina',
    icon: '⚓',
    count: businessesByCategory['marina']?.length || 0,
    description: 'Boat slips, launch services, and fuel docks.',
  },
  {
    name: 'Real Estate',
    slug: 'real-estate',
    icon: '🏡',
    count: businessesByCategory['real-estate']?.length || 0,
    description: 'Lake properties, cabins for sale, and realtors.',
  },
  {
    name: 'Home Services',
    slug: 'service',
    icon: '🔧',
    count: businessesByCategory['service']?.length || 0,
    description: 'Contractors, maintenance, and services for lake homeowners.',
  },
];
---

<Layout
  title="Business Directory"
  description="Find resorts, restaurants, fishing guides, boat rentals, and services around Mille Lacs Lake. Your complete guide to local businesses."
>
  <section class="directory-header">
    <div class="container">
      <h1>Mille Lacs Business Directory</h1>
      <p>Find everything you need around the lake - from resorts and restaurants to fishing guides and home services.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Categories Grid -->
      <div class="categories-grid">
        {categories.map((category) => (
          <a href={`/directory/${category.slug}`} class="category-card">
            <span class="category-card__icon">{category.icon}</span>
            <div class="category-card__content">
              <h3>{category.name}</h3>
              <p>{category.description}</p>
              <span class="category-card__count">{category.count} listing{category.count !== 1 ? 's' : ''}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Listings -->
  {featuredBusinesses.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-header">
          <h2>Featured Businesses</h2>
          <p>Premium listings from our partners</p>
        </div>

        <div class="grid grid--3">
          {featuredBusinesses.map((business) => (
            <a href={`/directory/${business.data.category}/${business.id}`} class="listing-card listing-card--featured">
              <div class="listing-card__image">
                <span class="listing-card__badge">Featured</span>
              </div>
              <div class="listing-card__content">
                <span class="listing-card__category">{business.data.category}</span>
                <h3>{business.data.name}</h3>
                <p class="listing-card__location">{business.data.city}</p>
                <p>{business.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="directory-cta">
    <div class="container text-center">
      <h2>Own a Business at Mille Lacs?</h2>
      <p>Get your business listed in our directory and reach thousands of visitors and lake homeowners.</p>
      <div class="cta-buttons">
        <a href="/submit-listing" class="btn btn--accent btn--large">Submit Free Listing</a>
        <a href="/advertise" class="btn btn--outline btn--large">Advertise With Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .directory-header {
    background: linear-gradient(135deg, var(--forest-dark) 0%, var(--lake-deep) 100%);
    color: var(--white);
    padding: var(--space-3xl) 0;
    text-align: center;
  }

  .directory-header h1 {
    color: var(--white);
    margin-bottom: var(--space-md);
  }

  .directory-header p {
    font-size: 1.125rem;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .category-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--text);
    transition: all var(--transition-normal);
    border: 2px solid transparent;
  }

  .category-card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .category-card__icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .category-card__content h3 {
    margin: 0 0 var(--space-xs) 0;
    font-size: 1.125rem;
    color: var(--primary);
  }

  .category-card__content p {
    margin: 0 0 var(--space-sm) 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .category-card__count {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--secondary);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-header p {
    color: var(--text-muted);
  }

  .listing-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: all var(--transition-normal);
    box-shadow: var(--shadow-sm);
  }

  .listing-card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .listing-card__image {
    height: 160px;
    background: linear-gradient(135deg, var(--lake-light) 0%, var(--forest-light) 100%);
    position: relative;
  }

  .listing-card__badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background: var(--accent);
    color: var(--white);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .listing-card__content {
    padding: var(--space-lg);
  }

  .listing-card__category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--secondary);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .listing-card__content h3 {
    margin: var(--space-xs) 0;
    font-size: 1.125rem;
  }

  .listing-card__location {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .listing-card__content p:last-child {
    margin: 0;
    font-size: 0.9rem;
  }

  .directory-cta {
    background: var(--lake-deep);
    color: var(--white);
    padding: var(--space-3xl) 0;
  }

  .directory-cta h2 {
    color: var(--white);
  }

  .directory-cta p {
    opacity: 0.9;
    max-width: 500px;
    margin: 0 auto var(--space-xl);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-buttons .btn--outline {
    border-color: var(--white);
    color: var(--white);
  }

  .cta-buttons .btn--outline:hover {
    background: var(--white);
    color: var(--lake-deep);
  }

  @media (max-width: 600px) {
    .category-card {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
